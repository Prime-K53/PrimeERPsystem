# ---------------------------------------------------------------------------
# Prime ERP Frontend — production environment variables
# Copy to .env (or set in your Vercel/Netlify project settings).
# ---------------------------------------------------------------------------

# Supabase (cloud sync / auth)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend REST API base URL (no trailing slash, no /api suffix)
# In production this must be the deployed backend, e.g. https://primeerpsystem.onrender.com
VITE_API_URL=https://primeerpsystem.onrender.com

# Exam module backend (same backend in this monorepo)
VITE_EXAM_BACKEND_URL=https://primeerpsystem.onrender.com

# Vite base path (default '/' — leave empty for root deploys)
# VITE_BASE_URL=/

# Enable PWA service worker (set to 'true' on HTTPS production hosts only)
# VITE_ENABLE_PWA_SW=true

# Feature flags
# VITE_ENABLE_MULTI_CURRENCY=true

# Public web origin embedded in customer-facing document QR codes
# (verification page <origin>/#/verify/<type>/<number>?t=<token>) AND used by
# the "Customer portal" link on the ERP login page.
# This MUST be the public Portal host. The Portal is a separate hash-routed
# deployment (login route <origin>/#/login). Development:
VITE_PUBLIC_PORTAL_URL=http://localhost:3001
# Production must set the real Portal production origin. The committed default
# for production builds is https://primeportalmw.vercel.app, which is also used
# when this variable is missing or still points at localhost — a production
# build never emits a localhost customer link.
# VITE_PUBLIC_PORTAL_URL=https://primeportalmw.vercel.app
# For QR codes, when unset in production the build fails closed (no verification
# URL is generated; the legacy QR payload is kept) instead of silently pointing
# new public QR codes at the private ERP origin. Local dev/test fall back to the
# running app origin only when this variable is missing.