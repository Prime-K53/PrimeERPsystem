# ---------------------------------------------------------------------------
# Prime ERP Frontend — production environment variables
# Copy to .env (or set in your Vercel/Netlify project settings).
# ---------------------------------------------------------------------------

# Supabase (cloud sync / auth)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend REST API base URL (no trailing slash, no /api suffix)
# In production this must be the deployed backend, e.g. https://primeerpsystem.onrender.com
VITE_API_URL=https://primeerpsystem.onrender.com

# Exam module backend (same backend in this monorepo)
VITE_EXAM_BACKEND_URL=https://primeerpsystem.onrender.com

# Vite base path (default '/' — leave empty for root deploys)
# VITE_BASE_URL=/

# Enable PWA service worker (set to 'true' on HTTPS production hosts only)
# VITE_ENABLE_PWA_SW=true

# Feature flags
# VITE_ENABLE_MULTI_CURRENCY=true

# Public web origin embedded in customer-facing document QR codes
# (verification page <origin>/#/verify/<type>/<number>?t=<token>).
# This MUST be the public Portal host. Development:
VITE_PUBLIC_PORTAL_URL=http://localhost:3001
# Production must set the real Portal production origin, e.g.
# VITE_PUBLIC_PORTAL_URL=https://portal.example.com
# When unset, production builds fail closed (no verification URL is
# generated; the legacy QR payload is kept) instead of silently pointing
# new public QR codes at the private ERP origin. Local dev/test fall back
# to the running app origin only when this variable is missing.