{
  "name": "prime-erp-backend",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "index.cjs",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "start": "node index.cjs",
    "dev": "node index.cjs",
    "postinstall": "npm rebuild sqlite3 2>/dev/null || echo 'sqlite3 rebuild skipped - native bindings may need manual rebuild'",
    "rebuild:sqlite3": "npm rebuild sqlite3",
    "test": "jest --forceExit --detectOpenHandles",
    "test:unit": "jest tests/profitMargin.unit.test.js --no-coverage",
    "test:integration": "jest tests/integration/ --no-coverage --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "audit": "npm audit --audit-level=high",
    "outdated": "npm outdated"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-forge": "^1.3.3",
    "nodemailer": "^7.0.12",
    "otplib": "^13.4.1",
    "sqlite3": "^5.1.7",
    "stripe": "^22.4.0",
    "zod": "^3.22.4"
  },
  "optionalDependencies": {
    "ioredis": "^5.4.1"
  }
}
