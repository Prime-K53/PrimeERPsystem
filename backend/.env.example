# Server
PORT=3000
NODE_ENV=production

# Company identity shown on the public invoice verification page
# COMPANY_NAME=Prime Printing Service

# Public Portal origin embedded in server-rendered official-document QR codes
# (<origin>/#/verify/<type>/<number>?t=<token>). The renderer bundle reads
# import.meta.env from globalThis.__PRIME_DOC_VITE_ENV__, which the official
# document service populates from this variable at load time.
# Development:
VITE_PUBLIC_PORTAL_URL=http://localhost:3001
# Production must set the real Portal production origin, e.g.
# VITE_PUBLIC_PORTAL_URL=https://portal.example.com
# When unset, production renderers stay fail-closed (legacy QR payload,
# never an ERP-origin fallback).

# Security - CHANGE THESE IN PRODUCTION
JWT_SECRET=your-256-bit-jwt-secret-here
SESSION_SECRET=your-session-secret-here
ENCRYPTION_KEY=your-32-char-encryption-key!!

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# CORS — comma-separated allowed browser origins (in addition to the built-in
# allowlist: primeerp.com, www.primeerp.com, admin.primeerp.com,
# portal.primeerp.com, *.vercel.app, *.netlify.app, localhost/LAN origins).
# In production (NODE_ENV=production) unknown origins are rejected.
# CORS_ORIGIN=https://primeerp.com,https://admin.primeerp.com,https://portal.primeerp.com

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@primeerp.com

# WhatsApp (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Database (optional - default is local file)
# DB_PATH=/data/prime-erp.db

# Supabase Cloud Sync — REQUIRED for /api/sync/ops to work (503 without these)
# SUPABASE_URL is the REST API URL of your Supabase project
# SUPABASE_ANON_KEY is the publishable/anon key (sb_publishable_* or eyJ... JWT)
# SUPABASE_PUBLISHABLE_KEY is an alias for SUPABASE_ANON_KEY (either works)
# SUPABASE_SECRET_KEY is the service-role key (bypasses RLS for sync writes)
#
# SUPABASE_URL=https://rdtuzuzehfbwvfdzqliw.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_xxxx
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
# SUPABASE_SECRET_KEY=sb_secret_xxxx
#
# On Render: set these under Environment → Environment Variables.
# WITHOUT SUPABASE_SECRET_KEY and SUPABASE_URL, /api/sync/ops returns 503.
#
# Portal → Supabase Auth migration (shadow-only, default OFF):
# PORTAL_SUPABASE_SHADOW enables the observe-and-log shadow identity path
# (staging only; never grants/denies authorization). Leave unset/OFF in
# production.
# Supabase Auth JWTs are verified asymmetrically against the project's JWKS
# endpoint (RS256/ES256 + kid selection). There is NO symmetric Supabase JWT
# secret: never provision one, and never reuse JWT_SECRET (legacy-only).
# SUPABASE_JWKS_URL pins the JWKS document (defaults to
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json when unset).
# SUPABASE_JWT_ISSUER / SUPABASE_JWT_AUDIENCE pin the expected iss/aud
# (defaults: <SUPABASE_URL>/auth/v1 and "authenticated").
#
# PORTAL_SUPABASE_SHADOW=false
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_ISSUER=
# SUPABASE_JWT_AUDIENCE=
#
# Phase 3 authoritative dual-auth (Portal business routes accept legacy
# Portal JWTs plus JWKS-verified Supabase JWTs mapped to an active
# portal_users.auth_user_id row). Safe default is OFF/absent (legacy-only);
# set PORTAL_SUPABASE_DUAL_AUTH=true to enable. Rollback requires only
# setting this back to false — no DB rollback needed.
# PORTAL_SUPABASE_DUAL_AUTH=false
#
# Phase 4 registration provisioning (approval creates a passwordless Supabase
# Auth user via the Admin API and maps portal_users.auth_user_id). Safe
# default is OFF/absent (approval behaves exactly as before); set
# PORTAL_SUPABASE_REGISTRATION_PROVISIONING=true to enable. Rollback is
# configuration-only. Never add a Supabase signing secret — Auth verification
# stays JWKS-based.
# PORTAL_SUPABASE_REGISTRATION_PROVISIONING=false

# Staff header authentication (dev-only bypass).
# ALLOW_HEADER_AUTH=false is the safe default for staging and dual-auth
# preparation: header auth (x-user-id / x-user-role) is then rejected and
# only verified JWT (or Supabase) authentication is accepted. Never enable
# in staging or production.
# ALLOW_HEADER_AUTH=false

# AI Configuration (for backend AI services - optional, algorithmic features work without it)
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-or-...
# AI_MODEL=cohere/north-mini-code:free
